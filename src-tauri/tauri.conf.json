{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dicto Desktop",
  "version": "0.1.0",
  "identifier": "com.dicto.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Dicto Desktop",
        "width": 800,
        "height": 600
      },
      {
        "label": "overlay",
        "title": "Dicto Overlay",
        "width": 280,
        "height": 80,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "visible": false,
        "x": 100,
        "y": 100,
        "url": "index.html#/overlay"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
